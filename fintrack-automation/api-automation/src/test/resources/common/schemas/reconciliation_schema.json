{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["reports"],
  "properties": {
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "report_date", "total_transactions", "total_debits", "total_credits", "is_balanced", "report_hash"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "report_date": { "type": "string", "format": "date" },
          "total_transactions": { "type": "integer", "minimum": 0 },
          "total_debits": { "type": "string" },
          "total_credits": { "type": "string" },
          "is_balanced": { "type": "boolean" },
          "report_hash": { "type": "string" }
        }
      }
    }
  }
}
