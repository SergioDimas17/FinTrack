{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["account"],
  "properties": {
    "account": {
      "type": "object",
      "required": ["id", "account_number", "holder_name", "status"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "account_number": { "type": "string", "pattern": "^FT-\\d{7}$" },
        "holder_name": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "frozen"] }
      }
    }
  }
}
