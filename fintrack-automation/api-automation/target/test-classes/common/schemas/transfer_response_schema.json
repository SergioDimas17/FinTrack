{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "transaction_id", "message"],
  "properties": {
    "success": { "type": "boolean", "enum": [true] },
    "transaction_id": { "type": "string", "format": "uuid" },
    "new_balance": { "type": ["number", "null"] },
    "message": { "type": "string" }
  }
}
